body {
  font-family: Arial;
  margin: 0;
  background: #f4f4f4;
}

header {
  background: #333;
  color: white;
  padding: 15px;
  display: flex;
  justify-content: space-between;
}

nav {
  background: #555;
  padding: 10px;
  text-align: center;
}

nav a {
  color: white;
  margin: 10px;
  text-decoration: none;
}

section {
  padding: 20px;
}

.profile {
  width: 150px;
  border-radius: 50%;
}

.card {
  background: white;
  padding: 15px;
  margin: 10px 0;
  border-radius: 10px;
}

#gallery img {
  width: 150px;
  margin: 10px;
  cursor: pointer;
}

#popup {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.8);
}

#popup img {
  display: block;
  max-width: 80%;
  margin: 50px auto;
}

.dark {
  background: #111;
  color: white;
}
